FROM ubuntu:26.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install --yes --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    gemmi \
    libgemmi-dev \
    nlohmann-json3-dev \
    ninja-build \
    python3 \
    python3-dev \
    python3-venv \
    && rm -rf /var/lib/apt/lists/*

RUN python3 -m venv /opt/venv \
    && /opt/venv/bin/pip install --no-cache-dir \
        'gemmi==0.7.4' \
        'jsonschema' \
        'mypy' \
        'nanobind>=2.11' \
        'numpy>=2.0' \
        'pytest'

WORKDIR /source
COPY . .

RUN cmake --preset gcc-release \
        -DCHARGEFW_PYTHON_EXECUTABLE=/opt/venv/bin/python \
    && cmake --build build/gcc-release --parallel \
    && ctest --test-dir build/gcc-release --output-on-failure -E '^cpptest$'
